{
  "name": "scenego",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:debug": "expo run:ios --configuration Debug",
    "ios:release": "expo run:ios --configuration Release",
    "ios:device:debug": "expo run:ios --device --configuration Debug",
    "ios:device:release": "expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "selftest": "bun run scripts/scenario-selftest.ts",
    "logictest": "bun run scripts/logic-selftest.ts",
    "check": "bunx tsc --noEmit && bun run scripts/scenario-selftest.ts && bun run scripts/logic-selftest.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.3",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.9",
    "expo-location": "~57.0.9",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "^57.0.0",
    "expo-status-bar": "~57.0.1",
    "promise": "8.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "^19",
    "typescript": "^7.0.0"
  },
  "private": true,
  "trustedDependencies": [
    "llama.rn"
  ],
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
