{
  "name": "scenego",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:debug": "expo run:ios --configuration Debug",
    "ios:release": "expo run:ios --configuration Release",
    "ios:device:debug": "expo run:ios --device --configuration Debug",
    "ios:device:release": "expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "selftest": "bun run scripts/scenario-selftest.ts",
    "logictest": "bun run scripts/logic-selftest.ts",
    "check": "bunx tsc --noEmit && bun run scripts/scenario-selftest.ts && bun run scripts/logic-selftest.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.0",
    "expo-camera": "~15.0.13",
    "expo-dev-client": "~4.0.29",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-image-manipulator": "~12.0.5",
    "expo-location": "~17.0.1",
    "expo-speech": "~12.0.2",
    "expo-status-bar": "~1.12.1",
    "promise": "8.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-web": "~0.19.10",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "typescript": "^5.1.3"
  },
  "private": true,
  "trustedDependencies": [
    "llama.rn"
  ]
}
